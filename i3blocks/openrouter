#!/usr/bin/env python3

import os
import requests
import subprocess
from pathlib import Path

api_key = Path(Path.home() / ".config/openrouter_api").read_text(encoding="utf-8").strip()
url = "https://openrouter.ai/api/v1/key"
headers = {"Authorization": f"Bearer {api_key}"}
try:
    response = requests.get(url, headers=headers)
    response.raise_for_status()
    data = response.json()
    key_data = data.get("data", {})
    limit = key_data.get("limit", 0)
    usage_daily = key_data.get("usage_daily", 0)
    usage_weekly = key_data.get("usage_weekly", 0)
    usage_montly = key_data.get("usage_montly", 0)
    print(f"{usage_daily:.0f} / {usage_weekly:.0f} / {usage_montly:.0f}")
except requests.exceptions.RequestException as e:
    print(f"Error fetching data from OpenRouter: {e}")
